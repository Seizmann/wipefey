# Wipefey environment variables
# Copy to `.env` (local) or set in Vercel project settings (production).
# Real values never committed.

# --- Rate limiting (Phase 5) ---
# Upstash Redis free-tier REST credentials for /api/check-limit.
# Get these from your Upstash console: Database -> REST API.
# These are the exact names the official @upstash/redis REST client expects.
# If unset/empty, the function returns a descriptive 500 (code
# 'misconfigured') — it never silently allows all traffic through. The
# frontend fails open on that 500, so the tool keeps working until real
# credentials are configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Example values (not real):
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token
