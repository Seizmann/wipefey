{
  "name": "wipefey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wipefey by RexiO — client-side photo metadata stripper + AI-generation marker heuristic. Free, open source, MIT.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:phase1": "esbuild scripts/verify-phase1.ts --bundle --platform=node --format=cjs --outfile=.verify/verify.cjs && node .verify/verify.cjs",
    "verify:phase2": "esbuild scripts/verify-phase2.ts --bundle --platform=node --format=cjs --outfile=.verify/verify-phase2.cjs && node .verify/verify-phase2.cjs",
    "prerender": "node scripts/prerender.mjs",
    "build:static": "tsc -b && vite build && node scripts/prerender.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "piexifjs": "1.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/piexifjs": "^1.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}